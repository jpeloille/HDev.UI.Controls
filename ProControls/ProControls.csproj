<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- NuGet Package Info -->
    <PackageId>ProControls.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Authors>Julien</Authors>
    <Description>Professional VS2022-style controls for Avalonia UI</Description>
    <PackageTags>avalonia;controls;ui;professional;vs2022</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datagrid de référence : source de vérité unique, ProControls n'ajoute que le skin VS2022 -->
    <ProjectReference Include="..\..\AvaloniaDataGrid\src\Julien.Avalonia.DataGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Theme/DataGrid/**/*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Interaction" />
    <InternalsVisibleTo Include="ProControls.Tests" />
  </ItemGroup>

</Project>
