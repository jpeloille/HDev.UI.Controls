<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProControls.Demo.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <!-- Accent Ubuntu pour les contrôles Fluent natifs (TextBox, éditeurs de la grille...) -->
        <Color x:Key="SystemAccentColor">#E95420</Color>
        <Color x:Key="SystemAccentColorDark1">#DB4C1B</Color>
        <Color x:Key="SystemAccentColorDark2">#C64614</Color>
        <Color x:Key="SystemAccentColorDark3">#A83C11</Color>
        <Color x:Key="SystemAccentColorLight1">#ED7748</Color>
        <Color x:Key="SystemAccentColorLight2">#F19970</Color>
        <Color x:Key="SystemAccentColorLight3">#F6BB98</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ProControls/Theme/DataGrid/Index.axaml" />
    </Application.Styles>
</Application>
