<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- NuGet Package Info -->
    <PackageId>HDev.UI.Controls</PackageId>
    <Version>1.0.0</Version>
    <Description>Professional VS2022-style controls for Avalonia UI</Description>
    <PackageTags>avalonia;controls;ui;professional;vs2022</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datagrid de référence : source de vérité unique, HDev.UI.Controls n'ajoute que le skin VS2022 -->
    <ProjectReference Include="..\..\HDev.UI.DataGrid\src\HDev.UI.DataGrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Theme/DataGrid/**/*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Interaction" />
    <InternalsVisibleTo Include="HDev.UI.Controls.Tests" />
  </ItemGroup>

</Project>
