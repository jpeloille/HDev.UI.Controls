<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HDev.UI.Controls.Demo.App"
             RequestedThemeVariant="Light">
    <!-- L'accent des contrôles Fluent natifs suit le thème HDev actif :
         HDev.UI.Controls/Theme/HDevAccents.axaml, inclus par Index.axaml.
         (Ne pas redéclarer SystemAccentColor ici : Application.Resources
         primerait sur les dictionnaires par thème.) -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HDev.UI.Controls/Theme/DataGrid/Index.axaml" />
    </Application.Styles>
</Application>
