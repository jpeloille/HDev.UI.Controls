<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HDev.UI.Controls.Demo.App"
             RequestedThemeVariant="Light">
    <!-- Accent des contrôles Fluent natifs et pinceaux HDev*Brush : publiés par
         HDevTheme.ApplyTo (App.axaml.cs), tenus à jour à chaque bascule de thème -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HDev.UI.Controls/Theme/DataGrid/Index.axaml" />

        <!-- Légendes de la démo -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource HDevTextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource HDevTextTertiaryBrush}"/>
        </Style>
    </Application.Styles>
</Application>
