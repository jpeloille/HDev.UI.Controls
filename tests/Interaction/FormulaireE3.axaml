<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:HDev.UI.Controls"
             xmlns:i="using:Interaction"
             x:Class="Interaction.FormulaireE3"
             x:DataType="i:FormulaireE3Vm"
             x:CompileBindings="True">
  <!-- Portage des éditeurs (E3) : chaque éditeur lié à son ViewModel, sans Mode explicite -->
  <StackPanel x:Name="Formulaire" Margin="20" Spacing="8">
    <h:HDevTextBox x:Name="Nom" Width="200" Text="{Binding Nom}" />
    <h:HDevSpinEdit x:Name="Quantite" Width="120" Decimals="2" Minimum="0" Maximum="100" Value="{Binding Quantite}" />
    <h:HDevTimeEdit x:Name="Heure" Width="120" Value="{Binding Heure}" />
    <h:HDevComboBox x:Name="Priorite" Width="160" ItemsSource="{Binding Priorites}" Value="{Binding Priorite}"
                    Placeholder="Choisir…" />
    <h:HDevLookUpEdit x:Name="Chef" Width="200" ItemsSource="{Binding Equipiers}" Value="{Binding ChefId}"
                      DisplayMemberBinding="{Binding Nom, x:DataType=i:Equipier}"
                      SelectedValueBinding="{Binding Id, x:DataType=i:Equipier}" Placeholder="Chef de cabine" />
    <h:HDevTokenEdit x:Name="Destinataires" Width="300" Value="{Binding Destinataires}" />
    <h:HDevCheckBox x:Name="Confirme" Label="Confirmé" IsChecked="{Binding Confirme}" />
    <h:HDevToggleSwitch x:Name="Actif" IsChecked="{Binding Actif}" />
    <h:HDevRadioButton x:Name="Matin" Label="Matin" GroupName="Service" IsChecked="{Binding Matin}" />
    <h:HDevRadioButton x:Name="Soir" Label="Soir" GroupName="Service" IsChecked="{Binding Soir}" />
    <h:HDevSlider x:Name="Charge" Width="200" Minimum="0" Maximum="100" Step="5" Value="{Binding Charge}" />
    <h:HDevMonthCalendar x:Name="Jour" SelectedDate="{Binding Jour}" />
    <h:HDevSearchControl x:Name="Recherche" Width="200" Text="{Binding Recherche}" />
  </StackPanel>
</UserControl>
